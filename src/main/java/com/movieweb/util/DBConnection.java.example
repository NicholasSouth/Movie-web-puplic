package com.movieweb.util;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;
public class DBConnection {
	private static final String URL =
            "jdbc:sqlserver://localhost:YOUR_PORT_HERE;"
          + "databaseName=MovieWeb;"
          + "encrypt=true;"
          + "trustServerCertificate=true;";
    
    private static final String USERNAME = "YOUR_SQL_USERNAME_HERE";
    private static final String PASSWORD = "YOUR_SQL_PASSWORD_HERE";
    
    public static Connection getConnection()
            throws SQLException
    {
        try
        {
            Class.forName("com.microsoft.sqlserver.jdbc.SQLServerDriver");
        }
        catch (ClassNotFoundException e)
        {
            throw new SQLException("SQL Server JDBC Driver was not found.", e);
        }
        return DriverManager.getConnection(URL, USERNAME, PASSWORD);
    }
}